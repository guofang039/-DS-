FROM rust:1.75-bookworm

RUN apt-get update && apt-get install -y \
    git pkg-config libssl-dev python3 cmake ninja-build \
    nasm yasm clang llvm mingw-w64 zip unzip \
    libgtk-3-dev libappindicator3-dev librsvg2-dev \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add x86_64-pc-windows-gnu

# Install Flutter
RUN git clone https://github.com/flutter/flutter.git -b stable --depth 1 /opt/flutter
ENV PATH="/opt/flutter/bin:${PATH}"
RUN flutter config --enable-windows-desktop
RUN flutter precache --windows

WORKDIR /workspace
COPY . .

# Build Windows portable version
ARG FLUTTER_ENGINE=auto
RUN flutter build windows --release 2>&1 | tail -30 || echo "Build attempted"
